+        i = 0
+        cur = fi.read(_STORE_CHUNK)
+        while True:
+            nxt = fi.read(_STORE_CHUNK)
+            last = 1 if not nxt else 0
+            c = AES.new(key, AES.MODE_GCM, nonce=base + i.to_bytes(4, "big"))
+            c.update(b"%d:%d" % (i, last))
