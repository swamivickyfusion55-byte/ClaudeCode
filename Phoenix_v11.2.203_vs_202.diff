+# The video, the replacement faces and the painted patch frames kept for a restart are written AES-256-GCM encrypted when the
+# Space secret PHOENIX_STORE_KEY is set (Space settings -> Variables and secrets -> New secret; any long random text). Each file
+# gets its own key (HKDF-SHA256 from the secret and a random salt) and is sealed in 4 MiB chunks: a changed, cut or reordered
+# file does not decrypt. The key is never written to disk. Without the secret the files are kept as before (plain) and the log
+# says so. A restart decrypts them into /tmp (not the persistent disk) for the job and deletes that copy afterwards.
+_STORE_MAGIC = b"PHXENC1\n"
+_STORE_CHUNK = 4 << 20
