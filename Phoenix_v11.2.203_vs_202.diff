+def _hkdf(secret, salt, info=b"phoenix-store-v1", n=32):
+    import hmac, hashlib
+    prk = hmac.new(salt, secret, hashlib.sha256).digest()
+    out, t, i = b"", b"", 1
+    while len(out) < n:
+        t = hmac.new(prk, t + info + bytes([i]), hashlib.sha256).digest(); out += t; i += 1
+    return out[:n]
+
