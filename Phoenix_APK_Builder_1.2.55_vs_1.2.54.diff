+    data class SkinPreview(val after: String?, val before: String?, val info: JSONObject?)
+
+    fun skinPreview(settings: HfSettings, videoServerPath: String, settingsJson: String): SkinPreview {
+        val result = callAndWait(settings, "phoenix_skin_preview", JSONArray().put(fileData(videoServerPath)).put(settingsJson), 300_000L)
+        val after = if (result.length() > 0) extractPath(result.opt(0)) else null
+        val before = if (result.length() > 1) extractPath(result.opt(1)) else null
+        val info = if (result.length() > 2) runCatching { JSONObject(result.optString(2)) }.getOrNull() else null
+        return SkinPreview(after, before, info)
+    }
