@@ -372,12 +372,16 @@
 
 
 def _mask_from_image(img):
+    """Painted pixels -> uint8 0/255. v11.2.179: the alpha channel only if it is USED (some pixels transparent, some not);
+    otherwise the brightest colour channel. The app saves its mask as an opaque PNG (ARGB: black background, white paint,
+    alpha 255 everywhere): v11.2.175-178 took that alpha, so the whole frame counted as painted - the Preview filled (darkened)
+    the whole picture instead of the mark, and a job's painted mark covered the whole frame."""
     if img is None:
         return None
-    if img.ndim == 3 and img.shape[2] == 4:
+    if img.ndim == 3 and img.shape[2] == 4 and int(img[..., 3].min()) < 128 < int(img[..., 3].max()) + 1:
         m = img[:, :, 3]
     elif img.ndim == 3:
-        m = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
+        m = img[:, :, :3].max(axis=2)
     else:
         m = img
     return ((m > 127).astype(np.uint8) * 255)
