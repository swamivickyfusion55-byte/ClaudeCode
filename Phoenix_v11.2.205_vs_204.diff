+def _skin_setting(raw):
+    """v11.2.205: the app's skin_tone ([a1..a4], -1..1 per replacement slot; 0 = unchanged) -> a plain list, or None."""
+    try:
+        import skin_tone as _STN
+        a = _STN.parse_amounts(raw)
+    except Exception:
+        logging.exception("skin_tone setting")
+        return None
+    if not a:
+        return None
+    out = [0.0, 0.0, 0.0, 0.0]
+    for k, v in a.items():
+        out[int(k)] = round(float(v), 3)
+    logging.info("skin tone: %s", out)
+    return out
+
+
+def _slot_people(faces, refs, slots, fill=True):
+    """Detected faces -> {slot: face}: by the Detect-frame references where given (as the job binds them), the rest left to
+    right in slot order (the job's own positional start)."""
+    faces = list(faces or [])
+    out, used = {}, set()
+    if refs:
+        pairs = []
+        for s_ in slots:
+            r = refs[s_] if s_ < len(refs) else None
+            if r is None:
+                continue
+            for i, f in enumerate(faces):
+                e = getattr(f, "normed_embedding", None)
