+def api_patch_preview(image, mask):
+    """v11.2.178: Patch Removal preview (the app's Preview button): the frame + the finger-painted mask -> (the frame with the mark
+    removed, JSON info). The same still fill the video job makes on the painted frame (patch_manual.remove_patch_image).
+    v11.2.175-177 had no such endpoint, so the app's Preview could not show the cleaned frame."""
+    t0 = time.time()
+    try:
+        import patch_manual as _PM
+        ip, mp = _coerce_video(image), _coerce_video(mask)
+        img = cv2.imread(str(ip), cv2.IMREAD_COLOR) if ip else None
+        msk = _mask_from_image(cv2.imread(str(mp), cv2.IMREAD_UNCHANGED)) if mp else None
+        if img is None:
+            return None, json.dumps({"ok": False, "error": "the frame is not a readable image"})
+        if msk is None or not (msk > 127).any():
+            return None, json.dumps({"ok": False, "error": "nothing is painted on the mask"})
+        out, info = _PM.remove_patch_image(img, msk)
+        root = Path(os.environ.get("GRADIO_TEMP_DIR") or tempfile.gettempdir()) / "phoenix_patch_preview"
+        root.mkdir(parents=True, exist_ok=True)
+        dest = root / f"patchprev_{uuid.uuid4().hex[:10]}.jpg"
+        cv2.imwrite(str(dest), out, [cv2.IMWRITE_JPEG_QUALITY, 93])
+        res = {"ok": True, "marks": len(info), "area_px": int(sum(int(i.get("area_px", 0)) for i in info)),
+               "inpainter": "still fill", "ms": int((time.time() - t0) * 1000),
+               "width": int(img.shape[1]), "height": int(img.shape[0]), "version": VERSION_FULL}
+        logging.info("phoenix_patch_preview: %s", res)
+        return str(dest), json.dumps(res)
+    except Exception as exc:
+        logging.exception("api_patch_preview")
+        return None, json.dumps({"ok": False, "error": f"{type(exc).__name__}: {str(exc)[:180]}"})
+
+
