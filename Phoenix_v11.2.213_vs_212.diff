+        from insightface.model_zoo import model_zoo
+        p = path
+        d = getattr(fa, "model_dir", None)
+        if p is None and d:
+            c = os.path.join(d, "1k3d68.onnx")
+            p = c if os.path.exists(c) else None
+        if p is None or not os.path.exists(p):
+            return False
+        prov = ["CPUExecutionProvider"]
+        try:
+            prov = list(fa.det_model.session.get_providers()) or prov
+        except Exception:
+            pass
+        m = model_zoo.get_model(p, providers=prov)
+        if m is None or getattr(m, "taskname", "") != "landmark_3d_68":
+            return False
+        m.prepare(ctx_id=0 if "CUDAExecutionProvider" in prov else -1)
