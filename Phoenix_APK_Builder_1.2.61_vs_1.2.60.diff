+    private fun pickedFrameJpeg(uri: Uri, pct: Int, tag: String): File? {
+        val app = getApplication<Application>()
+        var bmp: android.graphics.Bitmap? = null
+        return try {
+            val dur = PatchFrames.durationMs(app, uri)
+            if (dur <= 0L) return null
+            val t = (dur * pct.coerceIn(0, 100) / 100L).coerceAtMost((dur - 50L).coerceAtLeast(0L))
+            bmp = PatchFrames.frameAt(app, uri, t, DETECT_FRAME_PX) ?: return null
+            val f = File(app.cacheDir, "phoenix_${tag}_${System.nanoTime()}.jpg")
+            f.outputStream().use { out -> bmp!!.compress(android.graphics.Bitmap.CompressFormat.JPEG, 95, out) }
+            if (f.length() > 0L) f else { safeDelete(f); null }
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            throw e
+        } catch (e: Throwable) {
+            null
+        } finally {
+            runCatching { bmp?.recycle() }
+        }
+    }
