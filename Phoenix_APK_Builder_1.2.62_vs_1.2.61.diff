+        Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(10.dp),
+            verticalAlignment = Alignment.CenterVertically) {
+            listOf("Running" to spaceStatusColor("RUNNING", false), "Job running" to spaceStatusColor("RUNNING", true),
+                "Paused" to spaceStatusColor("PAUSED", false), "Starting" to spaceStatusColor("BUILDING", false),
+                "Error" to spaceStatusColor("RUNTIME_ERROR", false), "Asleep / not read" to spaceStatusColor(null, false)).forEach { (t, col) ->
+                Row(verticalAlignment = Alignment.CenterVertically) {
