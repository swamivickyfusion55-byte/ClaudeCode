+/** 1.2.62: asked before every pause or restart; says plainly when a job is running there (it would be lost). */
+@Composable
+private fun SpaceConfirmDialog(vm: PhoenixViewModel, c: PhoenixViewModel.SpaceConfirm) {
+    val pausing = c.action == "pause"
+    val verb = if (pausing) "Pause" else if (c.paused) "Resume" else "Restart"
+    val doing = if (pausing) "Pausing" else if (c.paused) "Resuming" else "Restarting"
+    AlertDialog(
+        onDismissRequest = { vm.dismissSpaceAction() },
+        title = { Text("$verb ${c.label}?") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text(
+                    when {
+                        pausing -> "It stops until you resume it, takes no jobs, and costs nothing while paused."
+                        c.paused -> "It starts again; that takes a few minutes. Then it takes jobs again."
+                        else -> "It stops and starts again; that takes a few minutes."
+                    },
+                    fontSize = 13.sp
+                )
+                when {
+                    c.checking -> Text("Checking whether a job is running there\u2026", color = Muted, fontSize = 12.5.sp)
+                    c.jobRunning -> Text(
+                        "A job is running on this Space (or it did not answer). $doing it stops that job, and it cannot " +
+                            "be resumed: the Space keeps nothing.",
+                        color = Color(0xFFB42318), fontSize = 12.5.sp, fontWeight = FontWeight.SemiBold
+                    )
+                    !c.paused -> Text("No job is running there.", color = GoodGreen, fontSize = 12.5.sp)
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { vm.confirmSpaceAction() }, enabled = !c.checking) {
+                Text(if (c.jobRunning) "$verb anyway" else verb,
+                    color = if (c.checking) Color(0xFF94A3B8) else if (c.jobRunning) Color(0xFFB42318) else Burgundy,
+                    fontWeight = FontWeight.Bold)
+            }
+        },
+        dismissButton = { TextButton(onClick = { vm.dismissSpaceAction() }) { Text("Cancel") } }
+    )
+}
