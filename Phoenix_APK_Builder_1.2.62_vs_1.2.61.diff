+    private fun hubSpaceCall(repoId: String, action: String, post: Boolean, verb: String): SpaceRuntime {
+        val token = tokenProvider()?.trim().orEmpty()
+        if (post && token.isEmpty()) throw IllegalStateException("Save a Hugging Face token with write access first")
+        val b = Request.Builder().url("${hubBase.trimEnd('/')}/api/spaces/$repoId/$action")
+        if (token.isNotEmpty()) b.header("Authorization", "Bearer $token")
+        if (post) b.post(ByteArray(0).toRequestBody(null)) else b.get()
+        try {
+            hubHttp.newCall(b.build()).execute().use { r ->
+                val body = r.body?.string().orEmpty()
+                if (!r.isSuccessful) {
+                    val why = runCatching { JSONObject(body).optString("error") }.getOrNull().orEmpty().ifBlank { body.take(160) }
+                    throw IllegalStateException(when (r.code) {
+                        401, 403 -> "The saved token may not $verb $repoId (HTTP ${r.code}). It needs write access to this Space: " +
+                            "a token with the \"write\" role, or a fine-grained token with write permission on this repository."
+                        404 -> "Hugging Face has no Space $repoId (HTTP 404). Check this Space's name and URL in the settings."
+                        429 -> "Hugging Face is limiting requests (HTTP 429). Try again in a minute."
+                        else -> "Could not $verb $repoId: HTTP ${r.code} $why".trim()
