+def _install_gender_score(fa):
+    """v11.2.212 (SDOS-212): keep the gender model's own score on each face (face['gender_s'], with P(male) = 1 / (1 + e^(-2 s))):
+    insightface keeps only the argmax, so a 0.51 and a 0.999 reading looked the same. The same computation as insightface 0.7.3's
+    Attribute.get (one model run); anything unexpected falls back to the original method. Returns True when installed."""
+    try:
+        m = (getattr(fa, "models", None) or {}).get("genderage")
+        if m is None or getattr(m, "_phx_gender_s", False):
+            return False
+        orig = m.get
+        from insightface.utils import face_align as _fal
+
+        def _get(img, face):
+            try:
+                b = face.bbox
+                w, h = (b[2] - b[0]), (b[3] - b[1])
+                center = (b[2] + b[0]) / 2, (b[3] + b[1]) / 2
+                _scale = m.input_size[0] / (max(w, h) * 1.5)
+                aimg, _M = _fal.transform(img, center, m.input_size[0], _scale, 0)
+                blob = cv2.dnn.blobFromImage(aimg, 1.0 / m.input_std, tuple(aimg.shape[0:2][::-1]),
+                                             (m.input_mean, m.input_mean, m.input_mean), swapRB=True)
+                pred = m.session.run(m.output_names, {m.input_name: blob})[0][0]
+                if len(pred) != 3:
+                    return orig(img, face)
+                gender = np.argmax(pred[:2])
+                age = int(np.round(pred[2] * 100))
+                face["gender"] = gender
+                face["age"] = age
+                face["gender_s"] = float(pred[1] - pred[0]) / 2.0
+                return gender, age
+            except Exception:
+                return orig(img, face)
+        m.get = _get
+        m._phx_gender_s = True
+        return True
+    except Exception as e:
+        log.debug("gender score not installed: %s", e)
+        return False
