+def _yaw_offset(kps):
+    """The nose's sideways offset from the eye midpoint, roll-corrected, in eye distances (as profile_weight): frontal
+    0.0-0.25, 36-45 deg 0.34-0.51, 55-71 deg 0.76-1.48. None without points."""
+    try:
+        k = np.asarray(kps, np.float32).reshape(-1, 2)
+        le, re, nose = k[0], k[1], k[2]
+        ev = re - le
+        ed = float(np.linalg.norm(ev)) + 1e-6
+        roll = float(np.arctan2(ev[1], ev[0]))
+        c, s = math.cos(-roll), math.sin(-roll)
+        rel = nose - (le + re) * 0.5
+        return abs(float(rel[0] * c - rel[1] * s)) / ed
+    except Exception:
+        return None
+
