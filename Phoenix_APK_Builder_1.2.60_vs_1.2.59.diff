+    /**
+     * 1.2.60: the picked video, copied once into Phoenix's own storage. Reading it through Android's storage provider for the
+     * whole cut or upload made Phoenix depend on that provider's process: when Android stopped it, Android closed Phoenix as
+     * well ("Phoenix was closed because a system part it needs stopped (depends on provider com.android.externalstorage ...
+     * in dying proc)"). The copy takes seconds; after it nothing outside Phoenix is needed. null = use the picked video as
+     * before (it is a file already, there is too little space, or the copy failed). The caller deletes the copy.
+     */
+    private fun localVideoCopy(uri: Uri, onStatus: (String) -> Unit = {}): File? {
+        if (uri.scheme != "content") return null
+        val app = getApplication<Application>()
+        var tmp: File? = null
+        return try {
+            val size = runCatching {
+                app.contentResolver.query(uri, arrayOf(OpenableColumns.SIZE), null, null, null)?.use { c ->
+                    if (c.moveToFirst() && !c.isNull(0)) c.getLong(0) else -1L
+                }
+            }.getOrNull() ?: -1L
+            val dir = app.cacheDir
+            if (size <= 0L || dir.usableSpace < size + LOCAL_COPY_SPARE_BYTES) return null
+            val dest = File(dir, "phoenix_src_${System.nanoTime()}.mp4")
+            tmp = File(dir, dest.name + ".part")
+            onStatus("Copying the video into Phoenix (${size / 1_048_576} MB)…")
+            val input = app.contentResolver.openInputStream(uri) ?: return null
+            input.use { inp -> tmp!!.outputStream().use { out -> inp.copyTo(out, 1 shl 20) } }
+            if (tmp!!.length() != size || !tmp!!.renameTo(dest)) {
+                safeDelete(tmp)
+                return null
+            }
+            dest
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            safeDelete(tmp)
+            throw e
+        } catch (e: Throwable) {
+            safeDelete(tmp)
+            null
+        }
+    }
