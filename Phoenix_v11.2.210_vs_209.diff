+def _hh_head(lmk):
+    """A face's 106-point outline with a forehead on top (the points of its upper third moved up): the outline ends at
+    the brows, the head in front of another face does not."""
+    l = np.asarray(lmk, np.float32).reshape(-1, 2)
+    top = float(l[:, 1].min())
+    h = float(l[:, 1].max()) - top
+    fh = l[l[:, 1] < top + 0.35 * h].copy()
+    fh[:, 1] -= 0.32 * h
+    return np.vstack([l, fh])
+
+
+def _hh_cover(lmk_x, lmk_y):
+    """The share of face X's outline that lies inside face Y's outline (both 106-point sets, picture coordinates)."""
+    try:
+        hx = cv2.convexHull(np.asarray(lmk_x, np.float32).reshape(-1, 2))
+        hy = cv2.convexHull(np.asarray(lmk_y, np.float32).reshape(-1, 2))
+        ax = float(cv2.contourArea(hx))
+        if ax < 1.0:
+            return 0.0
+        inter, _ = cv2.intersectConvexConvex(hx, hy)
+        return float(np.clip(inter / ax, 0.0, 1.0))
+    except Exception:
+        return 0.0
+
+
+def _hh_apply(A, pts):
+    return (np.asarray(pts, np.float32).reshape(-1, 2) @ A[:, :2].T + A[:, 2]).astype(np.float32)
+
+
+def _hh_flow(prev_bgr, cur_bgr, kps, lmk, excl_prev, excl_cur):
+    """v11.2.210: how the visible part of a face moved from the previous frame to this one - a 2x3 similarity in picture
+    coordinates, and how it was found ("flow": shift, turn and size from many points; "shift": the points agree on a shift
+    only). None when too few points can be followed. The face's own area (its outline with a forehead) less the faces in
+    front of it (``excl_*``: their outlines with a forehead, widened), corners followed with Lucas-Kanade both ways."""
+    try:
+        P = _hh_head(lmk) if lmk is not None else np.asarray(kps, np.float32).reshape(-1, 2)
+        x0, y0 = P.min(0)
+        x1, y1 = P.max(0)
+        w = float(max(x1 - x0, y1 - y0))
+        if w < 24.0:
+            return None, None
+        H, W = prev_bgr.shape[:2]
+        pad = 0.18 * w
+        rx0, ry0 = int(max(0, x0 - pad)), int(max(0, y0 - pad))
+        rx1, ry1 = int(min(W, x1 + pad)), int(min(H, y1 + pad))
+        if rx1 - rx0 < 24 or ry1 - ry0 < 24 or cur_bgr.shape[:2] != (H, W):
+            return None, None
+        s = float(min(1.0, 220.0 / w))
+        a = cv2.cvtColor(prev_bgr[ry0:ry1, rx0:rx1], cv2.COLOR_BGR2GRAY)
+        b = cv2.cvtColor(cur_bgr[ry0:ry1, rx0:rx1], cv2.COLOR_BGR2GRAY)
+        if s < 1.0:
+            a = cv2.resize(a, None, fx=s, fy=s, interpolation=cv2.INTER_AREA)
+            b = cv2.resize(b, None, fx=s, fy=s, interpolation=cv2.INTER_AREA)
+        off = np.float32([rx0, ry0])
+
+        def _poly(pts):
+            return cv2.convexHull(np.round((np.asarray(pts, np.float32) - off) * s).astype(np.int32))
+        m = np.zeros(a.shape[:2], np.uint8)
+        cv2.fillConvexPoly(m, _poly(P), 255)
+        front_now = np.zeros(a.shape[:2], np.uint8)
+        for group, tgt in ((excl_prev, m), (excl_cur, front_now)):
+            for el in group or []:
+                if el is None:
+                    continue
+                e = np.zeros(a.shape[:2], np.uint8)
+                cv2.fillConvexPoly(e, _poly(_hh_head(el)), 255)
+                d = int(max(2, round(0.06 * w * s)))
+                e = cv2.dilate(e, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * d + 1, 2 * d + 1)))
+                if tgt is m:
+                    m[e > 0] = 0
+                else:
+                    front_now[e > 0] = 255
+        m = cv2.erode(m, np.ones((5, 5), np.uint8))
+        if int((m > 0).sum()) < 150:
+            return None, None
+        p0 = cv2.goodFeaturesToTrack(a, maxCorners=160, qualityLevel=0.01, minDistance=5, mask=m, blockSize=5)
+        if p0 is None or len(p0) < 10:
+            return None, None
+        lk = dict(winSize=(17, 17), maxLevel=3, criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 20, 0.03))
+        p1, st1, _ = cv2.calcOpticalFlowPyrLK(a, b, p0, None, **lk)
+        p0r, st2, _ = cv2.calcOpticalFlowPyrLK(b, a, p1, None, **lk)
+        q0, q1 = p0.reshape(-1, 2), p1.reshape(-1, 2)
+        good = (st1.ravel() == 1) & (st2.ravel() == 1) & (np.linalg.norm(q0 - p0r.reshape(-1, 2), axis=1) < 1.0)
+        xi = np.clip(np.round(q1[:, 0]).astype(np.int32), 0, a.shape[1] - 1)
+        yi = np.clip(np.round(q1[:, 1]).astype(np.int32), 0, a.shape[0] - 1)
+        good &= front_now[yi, xi] == 0                       # (now under the face in front: it moves with that face)
+        if int(good.sum()) < 10:
+            return None, None
+        q0, q1 = q0[good], q1[good]
+        A, inl = cv2.estimateAffinePartial2D(q0, q1, method=cv2.RANSAC, ransacReprojThreshold=1.5, maxIters=400, confidence=0.99)
+        if A is None or inl is None:
+            return None, None
+        inl = inl.ravel().astype(bool)
+        if int(inl.sum()) < max(8, int(0.5 * len(q0))):
+            return None, None
+        kind = "flow"
+        sc = float(np.hypot(A[0, 0], A[1, 0]))
+        rot = float(np.degrees(np.arctan2(A[1, 0], A[0, 0])))
+        spread = q0[inl].std(axis=0)
+        if (float(spread.max()) < 0.08 * w * s or abs(sc - 1.0) > 0.04 or abs(rot) > 4.0):
+            # points all in one small spot cannot tell a turn or a size change: take their common shift
+            t = np.median(q1[inl] - q0[inl], axis=0)
+            A = np.float32([[1, 0, t[0]], [0, 1, t[1]]])
+            kind = "shift"
