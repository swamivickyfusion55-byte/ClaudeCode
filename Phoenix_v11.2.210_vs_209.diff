+        if ng < 10:
+            return None, None, 0
+        q0, q1 = q0[good], q1[good]
+        R, inl = cv2.estimateAffinePartial2D(q0, q1, method=cv2.RANSAC, ransacReprojThreshold=1.5, maxIters=400, confidence=0.99)
+        if R is None or inl is None:
+            return None, None, 0
+        inl = inl.ravel().astype(bool)
+        ni = int(inl.sum())
+        if ni < max(8, int(0.4 * ng)):
+            return None, None, 0
+        R = _hh_sim_fit(q0[inl], q1[inl]).astype(np.float64)                      # all agreeing corners, least squares
+        kind = "flow"
+        sc = float(np.hypot(R[0, 0], R[1, 0]))
+        rot = float(np.degrees(np.arctan2(R[1, 0], R[0, 0])))
+        spread = q0[inl].std(axis=0)
+        if float(spread.max()) < 0.07 * w * s or abs(sc - 1.0) > 0.05 or abs(rot) > 5.0:
+            # corners all in one small spot cannot tell a turn or a size change (a long thin strip can: its length does)
+            t = np.median(q1[inl] - q0[inl], axis=0)
+            R = np.array([[1.0, 0.0, t[0]], [0.0, 1.0, t[1]]])
+            kind = "shift"
+        if float(np.hypot(R[0, 2] + (R[0, 0] - 1) * w_ * 0.5, R[1, 2] + (R[1, 1] - 1) * h_ * 0.5)) > 0.20 * w * s:
+            return None, None, 0                             # the guess was far off: not a small correction any more
+        Rl, Rt = R[:, :2], R[:, 2]
