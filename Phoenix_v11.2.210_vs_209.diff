+        Nt = (Tl / s) @ (Rt - Rl @ (off.astype(np.float64) * s)) + Tl @ off.astype(np.float64) + Tt
+        return np.hstack([Nl, Nt.reshape(2, 1)]).astype(np.float32), kind, ni
+    except Exception as _e:
+        logging.debug("hidden-face tracking skipped: %s", _e)
+        return None, None, 0
+
