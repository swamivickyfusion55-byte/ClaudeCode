+        Al = np.asarray(A[:, :2], np.float32)
+        t = np.asarray(A[:, 2], np.float32) / s + off - Al @ off
+        return np.hstack([Al, t.reshape(2, 1)]).astype(np.float32), kind
+    except Exception as _e:
+        logging.debug("hidden-face flow skipped: %s", _e)
+        return None, None
+
+
+def _hh_sim_fit(src, dst):
+    """Least-squares similarity (shift, turn, size) taking the points ``src`` onto ``dst``: a 2x3 matrix."""
+    a = np.asarray(src, np.float64).reshape(-1, 2)
+    b = np.asarray(dst, np.float64).reshape(-1, 2)
+    ma, mb = a.mean(0), b.mean(0)
+    a0, b0 = a - ma, b - mb
+    den = float((a0 ** 2).sum())
+    if den < 1e-9:
+        return np.float32([[1, 0, mb[0] - ma[0]], [0, 1, mb[1] - ma[1]]])
+    c = float((a0 * b0).sum()) / den
+    s_ = float((a0[:, 0] * b0[:, 1] - a0[:, 1] * b0[:, 0]).sum()) / den
+    L = np.array([[c, -s_], [s_, c]])
+    t = mb - L @ ma
+    return np.hstack([L, t.reshape(2, 1)]).astype(np.float32)
+
+
+def _hh_compose(A, B):
+    """The motion B, then the motion A (both 2x3)."""
+    A3 = np.vstack([np.asarray(A, np.float64), [0, 0, 1]])
+    B3 = np.vstack([np.asarray(B, np.float64), [0, 0, 1]])
+    return (A3 @ B3)[:2].astype(np.float32)
+
+
+def _hh_ref_make(bgr, kps, lmk, excl):
+    """v11.2.210: the reference of a face that is about to go behind another - a grey crop around its head (about 220 px
+    wide), and corners to follow inside its own area (its outline with a forehead, less the faces in front, ``excl``).
+    None when there is too little to follow."""
+    try:
+        P = _hh_head(lmk)
+        x0, y0 = P.min(0)
+        x1, y1 = P.max(0)
+        w = float(max(x1 - x0, y1 - y0))
+        if w < 24.0:
+            return None
+        H, W = bgr.shape[:2]
+        pad = 0.18 * w
+        rx0, ry0 = int(max(0, x0 - pad)), int(max(0, y0 - pad))
+        rx1, ry1 = int(min(W, x1 + pad)), int(min(H, y1 + pad))
+        if rx1 - rx0 < 24 or ry1 - ry0 < 24:
+            return None
+        s = float(min(1.0, 220.0 / w))
+        a = cv2.cvtColor(bgr[ry0:ry1, rx0:rx1], cv2.COLOR_BGR2GRAY)
+        if s < 1.0:
+            a = cv2.resize(a, None, fx=s, fy=s, interpolation=cv2.INTER_AREA)
+        off = np.float32([rx0, ry0])
+
+        def _poly(pts):
+            return cv2.convexHull(np.round((np.asarray(pts, np.float32) - off) * s).astype(np.int32))
+        m = np.zeros(a.shape[:2], np.uint8)
+        cv2.fillConvexPoly(m, _poly(P), 255)
+        for el in excl or []:
+            if el is None:
+                continue
+            e = np.zeros(a.shape[:2], np.uint8)
+            cv2.fillConvexPoly(e, _poly(_hh_head(el)), 255)
+            d = int(max(2, round(0.06 * w * s)))
+            e = cv2.dilate(e, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * d + 1, 2 * d + 1)))
+            m[e > 0] = 0
+        m = cv2.erode(m, np.ones((5, 5), np.uint8))
+        if int((m > 0).sum()) < 200:
+            return None
+        p = cv2.goodFeaturesToTrack(a, maxCorners=220, qualityLevel=0.01, minDistance=5, mask=m, blockSize=5)
+        if p is None or len(p) < 16:
+            return None
+        return {"img": a, "off": off, "s": s, "w": w, "p": p.reshape(-1, 2).astype(np.float32)}
+    except Exception as _e:
+        logging.debug("hidden-face reference skipped: %s", _e)
+        return None
+
+
+def _hh_ref_track(ref, cur_bgr, T, excl_cur):
+    """v11.2.210: where the reference (_hh_ref_make) is on this frame. ``T`` (2x3) is the best guess of the motion from the
+    reference frame to this one; the frame is turned back by it, so what is left to find is small, and the corners are
+    followed from the reference itself - so nothing adds up from frame to frame. Returns the corrected motion, how it was
+    found ("flow": shift, turn and size; "shift": a shift only, when the corners lie in a narrow strip) and the number of
+    corners that agree; (None, None, 0) when too few do."""
+    try:
+        a, off, s, w = ref["img"], ref["off"], float(ref["s"]), float(ref["w"])
+        h_, w_ = a.shape[:2]
+        Tl = np.asarray(T[:, :2], np.float64)
+        Tt = np.asarray(T[:, 2], np.float64)
+        G = np.hstack([Tl / s, (Tl @ off.astype(np.float64) + Tt).reshape(2, 1)])     # reference crop -> this picture
+        b = cv2.warpAffine(cur_bgr, G.astype(np.float32), (w_, h_), flags=cv2.INTER_LINEAR | cv2.WARP_INVERSE_MAP,
+                           borderMode=cv2.BORDER_REPLICATE)
+        b = cv2.cvtColor(b, cv2.COLOR_BGR2GRAY)
+        p0 = ref["p"].reshape(-1, 1, 2)
+        lk = dict(winSize=(19, 19), maxLevel=3, criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 20, 0.03))
+        p1, st1, _ = cv2.calcOpticalFlowPyrLK(a, b, p0, None, **lk)
+        p0r, st2, _ = cv2.calcOpticalFlowPyrLK(b, a, p1, None, **lk)
+        q0, q1 = p0.reshape(-1, 2), p1.reshape(-1, 2)
+        good = (st1.ravel() == 1) & (st2.ravel() == 1) & (np.linalg.norm(q0 - p0r.reshape(-1, 2), axis=1) < 1.0)
+        # corners now under a face in front move with that face
+        cur = (q1.astype(np.float64) @ G[:, :2].T + G[:, 2]).astype(np.float32)
+        for el in excl_cur or []:
+            if el is None:
+                continue
+            hull = cv2.convexHull(_hh_head(el).astype(np.float32))
+            mg = 0.06 * float(max(np.ptp(hull[:, 0, 0]), np.ptp(hull[:, 0, 1])))
+            for i_ in np.nonzero(good)[0]:
