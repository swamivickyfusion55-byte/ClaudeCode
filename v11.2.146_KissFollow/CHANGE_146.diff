+def _rel_translation(hist_self, hist_partner, g, lo_rec, pg, long_frames):
+    """v11.2.146 (SDOS-146): a 2x3 translation that puts a face's last real box where it stood against its partner's box at its
+    last TOUCHING sighting within long_frames, measured in units of the partner's face width, relative to the partner's box now
+    (pg, at frame g). None when the two were not seen touching in that window, or pg is missing. A face lost while partly hidden
+    behind its partner stays with the partner, not at the place it had before the contact."""
+    try:
+        if lo_rec is None or pg is None or pg.get("bbox") is None:
+            return None
+        pdet = {}
+        for gg, rr in (hist_partner or []):
+            if rr.get("det") and rr.get("bbox") is not None:
+                pdet[int(gg)] = rr
+        best = None
+        for gg, rr in (hist_self or []):
+            gg = int(gg)
+            if (not rr.get("det") or rr.get("bbox") is None or gg > int(g) or gg < int(g) - int(long_frames) or gg not in pdet):
+                continue
+            b = np.asarray(rr["bbox"], np.float64)
+            pb = np.asarray(pdet[gg]["bbox"], np.float64)
+            pw = max(8.0, float(pb[2] - pb[0]))
+            d = (np.array([(b[0] + b[2]) / 2, (b[1] + b[3]) / 2]) - np.array([(pb[0] + pb[2]) / 2, (pb[1] + pb[3]) / 2])) / pw
+            if float(np.linalg.norm(d)) <= 1.2 and (best is None or gg > best[0]):
+                best = (gg, d)
+        if best is None:
+            return None
+        pgb = np.asarray(pg["bbox"], np.float64)
+        pwg = max(8.0, float(pgb[2] - pgb[0]))
+        want = np.array([(pgb[0] + pgb[2]) / 2, (pgb[1] + pgb[3]) / 2]) + best[1] * pwg
+        lb = np.asarray(lo_rec["bbox"], np.float64)
+        dx, dy = want - np.array([(lb[0] + lb[2]) / 2, (lb[1] + lb[3]) / 2])
+        return np.array([[1.0, 0.0, dx], [0.0, 1.0, dy]], np.float64)
+    except Exception:
+        return None
+
