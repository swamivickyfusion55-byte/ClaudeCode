+    def _partner_side(self, i, j, s, faces, slots, sim, sim_all, has_id_all):
+        """v11.2.146 (SDOS-146): in contact, detection j is the partly hidden face of slot i. It reads as ANOTHER identified person by
+        0.10 or more over this slot, it is not that person's own detection (their nearest, which is taken), and it touches that
+        person's detection. The face whose nose and upper face are behind the other's is never a clean crop: the identity gate
+        rejected it 87 times in the field log and it was painted on an old place. A sliver behind the other reads as nobody
+        and is not admitted here."""
